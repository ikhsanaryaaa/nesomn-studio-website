{
  "name": "@nesomn/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch run src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.726.0",
    "@aws-sdk/s3-request-presigner": "^3.726.0",
    "@elysiajs/cors": "1.4.2",
    "@nesomn/shared": "workspace:*",
    "bullmq": "^5.34.5",
    "drizzle-orm": "0.45.4",
    "elysia": "1.4.30",
    "jose": "^5.9.6",
    "postgres": "^3.4.5",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "bun-types": "1.4.4",
    "drizzle-kit": "0.31.11"
  }
}
