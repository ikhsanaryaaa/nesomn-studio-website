# Production template. Copy to a NEW deployment env file; never overwrite an existing .env.
# App validates these fields at startup. Replace both secrets with independently generated 32+ character values.
NODE_ENV=production
JWT_SECRET=replace-with-random-secret-at-least-32-characters
ENCRYPTION_KEY=replace-with-existing-encryption-key-or-new-random-key
# Never rotate ENCRYPTION_KEY without a re-encryption plan for existing provider credentials.

# External services: Docker network aliases OR managed/private DNS. URL-encode passwords.
DATABASE_URL=postgresql://nesomn:replace-password@nesomn-postgres:5432/nesomn
REDIS_URL=redis://:replace-password@nesomn-redis:6379/0
DATA_NETWORK=nesomn-data-network
# For managed Redis use rediss://user:password@private-host:6380/0 (certificate validation stays ON).

# Public origins, without path/trailing slash. Production needs HTTPS; HTTP only for localhost smoke testing.
CLIENT_URL=https://studio.example.com
ADMIN_URL=https://studio.example.com
API_URL=https://studio.example.com/api
PORT=3000

# Main Compose: only app and gateway. Default gateway is reachable by a host TLS proxy.
APP_IMAGE=nesomn-app:local
APP_ENV_FILE=.env
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8080

# Existing storage is external to Compose. Prepare/import it explicitly before startup.
STORAGE_DRIVER=local
STORAGE_PATH=/data/storage
STORAGE_VOLUME=nesomn-storage
# Alternative: STORAGE_DRIVER=r2, all four fields required. Private bucket + configured CORS.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Optional Google OIDC; both credentials plus exact redirect URI required.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://studio.example.com/api/auth/google/callback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PAKASIR_API_KEY=
PAKASIR_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
KIE_AI_API_KEY=
# Legacy checkout is disabled; Stripe webhook secret only enables verified legacy reconciliation.
# Production NEVER permits stub payments/AI, regardless of these flags.
ALLOW_PAYMENT_STUB=false
ALLOW_AI_STUB=false
AI_LEGACY_ADAPTER_ENABLED=false
AI_PROVIDER_HOSTS=
AI_INPUT_HOSTS=
AI_RESULT_HOSTS=
# Exact comma-separated HTTPS hostnames, no wildcards/IPs. Private DNS/redirects are refused.
# Enable legacy adapter only after verifying the vendor contract in staging; no implicit live activation.
# Provider credentials are encrypted in ai_providers; env KIE_AI_API_KEY alone does not configure registry.
# TRUST_PROXY=1 is injected only into the private app by main Compose; standalone default ignores XFF.
# VITE_API_URL is fixed to /api during image build. No merchant secret belongs in a VITE_* variable.
# AI worker: independent root Dockerfile --target worker, same DB/Redis/ENCRYPTION_KEY.
# Independent QRIS adapter/configuration: docs/payments-qris.md. No live credentials included.
# Optional QRIS ShopeePay. Disabled until operator verifies its own static QR and portal scope.
QRIS_ENABLED=false
QRIS_MERCHANT_ID=
QRIS_STORE_ID=
QRIS_STATIC_PAYLOAD=
QRIS_TEMPLATE_SHA256=
QRIS_EXPECTED_NAME=
QRIS_RECEIPT_SECRET=
# QRIS_RECEIPT_SECRET: independent random32+ chars shared only with dedicated receipt worker.
# Invoice/payment amount is never reused within merchant/store. Exhaustion requires reconciliation.
