{
  "name": "nesomn-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "workspaces": [
    "client",
    "admin",
    "api",
    "worker",
    "packages/*"
  ],
  "scripts": {
    "check:runtime": "bun run scripts/check-runtime.mjs",
    "preinstall": "bun run check:runtime",
    "dev": "bun run check:runtime && bun --filter '*' dev",
    "build": "bun run check:runtime && bun --filter '*' build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "bun run check:runtime && bun --filter '*' typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "minimatch": "11.0.3",
    "esbuild": "0.28.1",
    "path-to-regexp": "8.4.0"
  }
}
