# Separate AI-worker env. Keep outside Git after filling real values.
NODE_ENV=production
DATABASE_URL=postgresql://nesomn:replace-password@nesomn-postgres:5432/nesomn
REDIS_URL=redis://:replace-password@nesomn-redis:6379/0
ENCRYPTION_KEY=replace-with-the-SAME-existing-provider-encryption-key
# No JWT/OAuth/payment/SMTP/R2 credentials needed by current worker.
# Provider credentials are decrypted from ai_providers using ENCRYPTION_KEY.

# Production never resolves missing providers into demos. Registry credentials remain encrypted.
ALLOW_AI_STUB=false
AI_LEGACY_ADAPTER_ENABLED=false
AI_PROVIDER_HOSTS=
AI_INPUT_HOSTS=
AI_RESULT_HOSTS=
# Explicitly verify vendor contract before enabling the legacy adapter. No wildcard/private DNS.
