# Independent QRIS app; no public domain. Keep disabled/stopped until merchant verification.
QRIS_HEALTH_PORT=3002
QRIS_MERCHANT_ID=replace-numeric-merchant
QRIS_STORE_ID=replace-numeric-store
QRIS_INGEST_URL=https://studio.example.com/api/billing/qris/receipts
QRIS_RECEIPT_SECRET_FILE=/run/secrets/qris-receipt
SHOPEE_TOKEN_FILE=/run/secrets/shopee-token
QRIS_STATE_PATH=/data/receipts.sqlite
QRIS_BACKFILL_START=replace-verified-unix-seconds
# Mount durable /data writable by UID 10001. Mount secrets read-only.
# shopee-token must be mode 0600, readable by UID 10001.
# qris-receipt must match app QRIS_RECEIPT_SECRET, independently generated from JWT/encryption key.
# HTTPS delivery recommended. Private HTTP requires QRIS_ALLOW_PRIVATE_HTTP=true and verified app alias.
