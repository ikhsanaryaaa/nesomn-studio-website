# Independent worker app; no public domain.
NODE_ENV=production
WORKER_HEALTH_PORT=3001
DATABASE_URL=postgresql://nesomn:replace-password@POSTGRES_PRIVATE_HOST:5432/nesomn
REDIS_URL=redis://:replace-password@REDIS_PRIVATE_HOST:6379/0
ENCRYPTION_KEY=replace-with-the-SAME-existing-provider-encryption-key
ALLOW_AI_STUB=false
AI_LEGACY_ADAPTER_ENABLED=false
AI_PROVIDER_HOSTS=
AI_INPUT_HOSTS=
AI_RESULT_HOSTS=
# Same allowlists/provider config as the app. No JWT/OAuth/merchant secrets.
