# Runtime variables only. Enter real secrets in Litepod, never commit them.
NODE_ENV=production
PORT=3000
# Ignore caller-supplied XFF by default. Enable only after verifying the trusted proxy boundary.
TRUST_PROXY=0
CLIENT_URL=https://studio.example.com
# An origin, not https://studio.example.com/admin
ADMIN_URL=https://studio.example.com
DATABASE_URL=postgresql://nesomn:replace-password@POSTGRES_PRIVATE_HOST:5432/nesomn
REDIS_URL=redis://:replace-password@REDIS_PRIVATE_HOST:6379/0
JWT_SECRET=replace-with-existing-or-random-secret-at-least-32-characters
ENCRYPTION_KEY=replace-with-existing-provider-encryption-key
# R2 avoids a host-local writable upload volume. All four values are required.
STORAGE_DRIVER=r2
R2_ENDPOINT=https://ACCOUNT.r2.cloudflarestorage.com
R2_BUCKET=replace-private-bucket
R2_ACCESS_KEY_ID=replace-access-key
R2_SECRET_ACCESS_KEY=replace-secret-key
# For existing local storage instead: STORAGE_DRIVER=local, STORAGE_PATH=/data/storage
# Attach the RESTORED existing upload volume at /data/storage, writable by container UID 1000.
ALLOW_PAYMENT_STUB=false
ALLOW_AI_STUB=false
AI_LEGACY_ADAPTER_ENABLED=false
AI_PROVIDER_HOSTS=
AI_INPUT_HOSTS=
AI_RESULT_HOSTS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://studio.example.com/api/auth/google/callback
QRIS_ENABLED=false
# Add QRIS fields from .env.example only after verifying merchant/store/static QR.
# Preserve old provider webhook secrets if reconciling old invoices.

# Optional split-domain mode; see docs/split-domains.md. Set all four origins together.
# LANDING_URL=https://nesomn.studio
# CLIENT_URL=https://shop.nesomn.studio
# ADMIN_URL=https://dashboard.nesomn.studio
# API_URL=https://api.nesomn.studio
# Build arguments: VITE_LANDING_URL, VITE_SHOP_URL, VITE_ADMIN_URL, VITE_API_URL.
