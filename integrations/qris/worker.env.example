# Dedicated worker only. Never use this file for main app or commit populated secrets.
QRIS_MERCHANT_ID=
QRIS_STORE_ID=
QRIS_RECEIPT_SECRET_FILE=/run/secrets/receipt-key
SHOPEE_TOKEN_FILE=/run/secrets/shopee-token
QRIS_INGEST_URL=https://studio.example.com/api/billing/qris/receipts
QRIS_STATE_PATH=/data/receipts.sqlite
# Explicit UTC epoch BEFORE first invoice. Initial historical receipts are ingested, never seeded away.
QRIS_BACKFILL_START=
# Private Docker network HTTP only if deliberately selected; HTTPS preferred across hosts.
QRIS_ALLOW_PRIVATE_HTTP=false
